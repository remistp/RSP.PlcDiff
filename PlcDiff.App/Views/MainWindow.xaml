<Window x:Class="PlcDiff.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:viewModels="clr-namespace:PlcDiff.App.ViewModels"
        xmlns:converters="clr-namespace:PlcDiff.App.Converters"
        xmlns:controls="clr-namespace:PlcDiff.App.Controls"
        mc:Ignorable="d"
        Title="PlcDiff" Height="700" Width="1200">
  <Window.DataContext>
    <viewModels:MainViewModel />
  </Window.DataContext>

  <Window.Resources>
    <converters:ChangeKindToBrushConverter x:Key="ChangeKindToBrushConverter" />
    <converters:ChangeKindToSymbolConverter x:Key="ChangeKindToSymbolConverter" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:CommandBar DefaultLabelPosition="Bottom">
      <ui:AppBarButton Icon="OpenFile" Label="Open A" Command="{Binding OpenProjectACommand}" />
      <ui:AppBarButton Icon="OpenFile" Label="Open B" Command="{Binding OpenProjectBCommand}" />
      <ui:AppBarButton Icon="Play" Label="Compare" Command="{Binding CompareCommand}" />
    </ui:CommandBar>

    <Grid Grid.Row="1" Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="5*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="6" BorderBrush="#33000000" BorderThickness="1" Padding="8" Margin="0,0,8,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Programs &amp; Routines" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TreeView ItemsSource="{Binding ProgramTree}">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" />
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <TextBlock DockPanel.Dock="Top" Text="Changes" FontWeight="SemiBold" Margin="0,12,0,8" />
          <ListView ItemsSource="{Binding ChangeItems}" SelectedItem="{Binding SelectedChange}" BorderThickness="0">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                  <ui:SymbolIcon Symbol="{Binding ChangeKind, Converter={StaticResource ChangeKindToSymbolConverter}}"
                                 Foreground="{Binding ChangeKind, Converter={StaticResource ChangeKindToBrushConverter}}"
                                 Width="20" Height="20" Margin="0,0,8,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Path}" Foreground="#88000000" FontSize="12" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" CornerRadius="6" BorderBrush="#33000000" BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Hunk Diff" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="{Binding SelectedChange.Path}" FontWeight="SemiBold" />
              <TextBlock Grid.Row="1" Text="HUNK 1: Changed Rungs" FontWeight="SemiBold" Margin="0,8,0,8" />
              <ItemsControl Grid.Row="2" ItemsSource="{Binding RungHunks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <ItemsControl ItemsSource="{Binding Changes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border BorderBrush="{Binding Change.ChangeKind, Converter={StaticResource ChangeKindToBrushConverter}}"
                                    BorderThickness="2" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                              <StackPanel>
                                <TextBlock Text="{Binding Change.Summary}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Before" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <controls:LadderRenderer Tokens="{Binding BeforeTokens}" ChangeKind="{Binding Change.ChangeKind}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1">
                                    <TextBlock Text="After" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <controls:LadderRenderer Tokens="{Binding AfterTokens}" ChangeKind="{Binding Change.ChangeKind}" />
                                  </StackPanel>
                                </Grid>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
